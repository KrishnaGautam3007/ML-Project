{
  "manifest_version": 3,
  "name": "GNN Vulnerability Scanner",
  "version": "0.2.0",
  "description": "Highlights risky C/C++ functions on GitHub using a Hybrid GraphSAGE model running locally.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://github.com/*",
    "https://raw.githubusercontent.com/*",
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Vulnerability Scanner"
  }
}
